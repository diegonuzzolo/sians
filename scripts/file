#!/bin/bash
# setup_server.sh - setup server Minecraft Bedrock

# --- Imposta locale per eliminare warning ---
export LC_ALL=C.UTF-8
export LANG=C.UTF-8
locale-gen C.UTF-8
update-locale LANG=C.UTF-8

# --- Aggiorna repository e installa pacchetti necessari ---
apt-get update -y
apt-get install -y curl jq unzip screen locales

# --- Percorso del server Bedrock ---
SERVER_DIR="/root/minecraft_bedrock"
mkdir -p "$SERVER_DIR"

# --- Imposta permessi ---
chown -R root:root "$SERVER_DIR"
chmod -R 755 "$SERVER_DIR"

echo "Setup completato. Cartella server: $SERVER_DIR"
